{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readin.local/schemas/v0.1/local-source-export.schema.json",
  "title": "Prepared local profile observation batch",
  "type": "object",
  "required": ["schema_version", "export_id", "grant_id", "asset_entity_id", "prepared_at", "parser", "handling", "observations"],
  "properties": {
    "schema_version": {"const": "readin.local-source-export.v0.1"},
    "export_id": {"type": "string", "format": "uuid"},
    "grant_id": {"type": "string", "format": "uuid"},
    "asset_entity_id": {"type": "string", "format": "uuid"},
    "prepared_at": {"type": "string", "format": "date-time"},
    "parser": {"const": "GENERIC_JSON_OBSERVATION_BATCH"},
    "handling": {
      "type": "object",
      "required": ["owner_attestation", "private_counterparty_data", "credential_material", "network_access", "raw_export_retention"],
      "properties": {
        "owner_attestation": {"const": "SELF_OR_CONTROLLED_ASSETS_ONLY"},
        "private_counterparty_data": {"const": "EXCLUDED"},
        "credential_material": {"const": "ABSENT"},
        "network_access": {"const": false},
        "raw_export_retention": {"const": "USER_MANAGED_NOT_RECORDED"}
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["record_key", "observation_type", "observed_at", "structured_payload"],
        "properties": {
          "record_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "observation_type": {"const": "social.profile_metadata"},
          "observed_at": {"type": "string", "format": "date-time"},
          "structured_payload": {
            "type": "object",
            "required": ["platform", "account_identifier", "display_name"],
            "properties": {
              "platform": {"type": "string", "minLength": 1, "maxLength": 80},
              "account_identifier": {"type": "string", "minLength": 1, "maxLength": 320},
              "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
              "profile_url": {"type": "string", "format": "uri", "maxLength": 2048}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
