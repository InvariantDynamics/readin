{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.readin.dev/v0.1/connector-grant-source.schema.json",
  "title": "READIN Connector Grant Source v0.1",
  "description": "Closed local manifest for recording connector readiness and source grants for a declared asset without enabling live collection.",
  "type": "object",
  "required": [
    "schema_version",
    "grant_id",
    "declared_at",
    "owner",
    "asset",
    "provider",
    "purpose",
    "grant",
    "authority",
    "source",
    "scopes",
    "allowed_observation_types",
    "retention",
    "revocation",
    "audit"
  ],
  "properties": {
    "schema_version": { "const": "readin.connector-grant-source.v0.1" },
    "grant_id": { "$ref": "#/$defs/uuid" },
    "declared_at": { "$ref": "#/$defs/timestamp" },
    "owner": { "$ref": "#/$defs/owner" },
    "asset": { "$ref": "#/$defs/assetReference" },
    "provider": { "$ref": "#/$defs/provider" },
    "purpose": { "$ref": "#/$defs/purpose" },
    "grant": { "$ref": "#/$defs/grant" },
    "authority": { "$ref": "#/$defs/authority" },
    "source": { "$ref": "#/$defs/source" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/scope" }
    },
    "allowed_observation_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/allowedObservationType" }
    },
    "retention": { "$ref": "#/$defs/retention" },
    "revocation": { "$ref": "#/$defs/revocation" },
    "audit": { "$ref": "#/$defs/audit" }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableUri": {
      "oneOf": [
        { "type": "string", "format": "uri", "maxLength": 2048 },
        { "type": "null" }
      ]
    },
    "observationType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "owner": {
      "type": "object",
      "required": ["label", "attestation", "scope"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "attestation": { "const": "USER_ATTESTED_NOT_VERIFIED" },
        "scope": { "const": "SELF_OR_CONTROLLED_ASSETS_ONLY" }
      },
      "additionalProperties": false
    },
    "assetReference": {
      "type": "object",
      "required": [
        "entity_id",
        "catalog_id",
        "asset_key",
        "asset_class",
        "platform",
        "account_identifier"
      ],
      "properties": {
        "entity_id": { "$ref": "#/$defs/uuid" },
        "catalog_id": { "$ref": "#/$defs/uuid" },
        "asset_key": { "type": "string", "minLength": 1, "maxLength": 768 },
        "asset_class": {
          "enum": [
            "SOCIAL_ACCOUNT",
            "ORGANIZATION_ACCOUNT",
            "SOFTWARE_REPOSITORY",
            "WEB_PROPERTY",
            "DOCUMENT_COLLECTION",
            "EMAIL_ACCOUNT",
            "CALENDAR_ACCOUNT",
            "FINANCIAL_ACCOUNT",
            "DEVICE",
            "LOCAL_FILE_COLLECTION",
            "OTHER"
          ]
        },
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "account_identifier": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": [
        "platform",
        "connector_kind",
        "connector_name",
        "connector_version",
        "terms_review_state",
        "terms_reference_uri"
      ],
      "properties": {
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 },
        "connector_kind": {
          "enum": [
            "MANUAL",
            "LOCAL_EXPORT",
            "OAUTH_API",
            "PUBLIC_WEB",
            "GITHUB_PUBLIC",
            "GOOGLE_TAKEOUT",
            "SOCIAL_EXPORT",
            "BROKERAGE_EXPORT",
            "EMAIL_EXPORT",
            "CALENDAR_EXPORT"
          ]
        },
        "connector_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "connector_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "terms_review_state": {
          "enum": [
            "NOT_REVIEWED",
            "USER_ATTESTED_ALLOWED",
            "REQUIRES_REVIEW"
          ]
        },
        "terms_reference_uri": { "$ref": "#/$defs/nullableUri" }
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "object",
      "required": ["kind", "statement", "secondary_use"],
      "properties": {
        "kind": {
          "enum": [
            "CONNECTOR_READINESS_ASSESSMENT",
            "LOCAL_EXPORT_IMPORT_PREP",
            "PERSONAL_ASSET_CATALOG_OPERATIONALIZATION",
            "SYSTEM_CAPABILITY_EVALUATION"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "secondary_use": { "const": "PROHIBITED" }
      },
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "required": [
        "grant_kind",
        "grant_state",
        "authorization_basis",
        "access_mode",
        "collection_state",
        "credential_material",
        "credential_storage",
        "oauth_state",
        "live_collection_state",
        "network_access",
        "external_action_state",
        "people_targeting",
        "activation_requirement"
      ],
      "properties": {
        "grant_kind": {
          "enum": [
            "MANUAL_ENTRY_ONLY",
            "LOCAL_EXPORT_ONLY",
            "OAUTH_API_REQUIRES_SEPARATE_TOKEN_FLOW",
            "PUBLIC_ENDPOINT_REQUIRES_SEPARATE_POLICY"
          ]
        },
        "grant_state": { "const": "RECORDED_NOT_ACTIVE" },
        "authorization_basis": {
          "enum": [
            "USER_OWNED_ACCOUNT_ATTESTED",
            "USER_ADMINISTERED_ASSET_ATTESTED",
            "OTHERWISE_AUTHORIZED_ATTESTED"
          ]
        },
        "access_mode": {
          "enum": [
            "MANUAL_ENTRY_ONLY",
            "LOCAL_EXPORT_IMPORT_ONLY",
            "API_CONNECTION_REQUIRES_SEPARATE_TOKEN_FLOW",
            "PUBLIC_ENDPOINT_POLICY_REQUIRED"
          ]
        },
        "collection_state": { "const": "NOT_STARTED" },
        "credential_material": { "const": "ABSENT" },
        "credential_storage": { "const": "PROHIBITED" },
        "oauth_state": { "enum": ["NOT_REQUIRED", "NOT_REQUESTED"] },
        "live_collection_state": { "const": "DISABLED" },
        "network_access": { "const": false },
        "external_action_state": { "const": "PROHIBITED" },
        "people_targeting": { "const": "PROHIBITED" },
        "activation_requirement": { "const": "SEPARATE_EXPLICIT_CONNECTOR_GRANT_REQUIRED" }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "state",
        "collection",
        "external_actions",
        "credential_storage",
        "network_access",
        "people_targeting"
      ],
      "properties": {
        "state": { "const": "NO_AUTHORITY" },
        "collection": { "const": "NOT_STARTED" },
        "external_actions": { "const": "PROHIBITED" },
        "credential_storage": { "const": "PROHIBITED" },
        "network_access": { "const": false },
        "people_targeting": { "const": "PROHIBITED" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "network_access",
        "credential_material",
        "path_retention"
      ],
      "properties": {
        "kind": { "const": "USER_DECLARED_LOCAL_GRANT_MANIFEST" },
        "network_access": { "const": false },
        "credential_material": { "const": "ABSENT" },
        "path_retention": { "const": "NOT_RECORDED_IN_LEDGER" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "scope_name",
        "source_surface",
        "data_category",
        "access_intent",
        "minimization",
        "private_counterparty_data",
        "claim_extraction"
      ],
      "properties": {
        "scope_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "source_surface": { "type": "string", "minLength": 1, "maxLength": 160 },
        "data_category": {
          "enum": [
            "ACCOUNT_PROFILE_METADATA",
            "USER_AUTHORED_CONTENT_METADATA",
            "OWNED_REPOSITORY_METADATA",
            "OWNED_DOCUMENT_METADATA",
            "OWNED_TRANSACTION_METADATA",
            "LOCAL_DEVICE_METADATA",
            "OTHER_SELF_CONTROLLED_METADATA"
          ]
        },
        "access_intent": {
          "enum": [
            "ADMIT_AS_OBSERVATION_ONLY",
            "CATALOG_METADATA_ONLY",
            "LOCAL_EXPORT_PARSE_ONLY",
            "READ_ONLY_IF_SEPARATELY_ENABLED"
          ]
        },
        "minimization": { "const": "MINIMUM_NECESSARY" },
        "private_counterparty_data": { "const": "EXCLUDED" },
        "claim_extraction": { "const": "PROHIBITED" }
      },
      "additionalProperties": false
    },
    "allowedObservationType": {
      "type": "object",
      "required": [
        "observation_type",
        "admission_state",
        "claim_extraction",
        "external_action_state"
      ],
      "properties": {
        "observation_type": { "$ref": "#/$defs/observationType" },
        "admission_state": { "const": "CONTRACTED_NOT_ENABLED" },
        "claim_extraction": { "const": "PROHIBITED" },
        "external_action_state": { "const": "PROHIBITED" }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "required": [
        "local_retention_days",
        "raw_export_retention",
        "path_retention"
      ],
      "properties": {
        "local_retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "raw_export_retention": {
          "enum": [
            "DELETE_AFTER_IMPORT_REQUIRED",
            "USER_MANAGED_NOT_RECORDED",
            "NOT_APPLICABLE"
          ]
        },
        "path_retention": { "const": "NOT_RECORDED_IN_LEDGER" }
      },
      "additionalProperties": false
    },
    "revocation": {
      "type": "object",
      "required": ["state", "operator_action"],
      "properties": {
        "state": {
          "enum": [
            "NOT_ACTIVE_NO_REVOCATION_NEEDED",
            "MANUAL_REVOCATION_REQUIRED_IF_ACTIVATED"
          ]
        },
        "operator_action": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": [
        "receipt_required",
        "path_retention",
        "token_storage",
        "execution_log",
        "redaction_policy"
      ],
      "properties": {
        "receipt_required": { "const": true },
        "path_retention": { "const": "NOT_RECORDED_IN_LEDGER" },
        "token_storage": { "const": "PROHIBITED" },
        "execution_log": { "const": "REQUIRED_BEFORE_COLLECTION" },
        "redaction_policy": { "const": "REQUIRED_BEFORE_COUNTERPARTY_DATA" }
      },
      "additionalProperties": false
    }
  }
}
