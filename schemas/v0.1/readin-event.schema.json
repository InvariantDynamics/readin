{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.readin.dev/v0.1/readin-event.schema.json",
  "title": "READIN Event v0.1",
  "description": "Closed event envelope for the READIN Phase 0 through Phase 2 local ledger.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "authority_state",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "readin.event.v0.1" },
    "event_id": { "$ref": "#/$defs/uuid" },
    "event_type": {
      "enum": [
        "entity.created",
        "asset.tracking_started",
        "observer_frame.registered",
        "evidence.manifested",
        "observation.admitted",
        "evidence.dependency_declared",
        "claim.created",
        "evidence.linked",
        "relation.created",
        "entity.resolution_candidate_recorded",
        "entity.resolution_candidate_assessed"
      ]
    },
    "occurred_at": { "$ref": "#/$defs/timestamp" },
    "authority_state": { "const": "NO_AUTHORITY" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "event_type": { "const": "entity.created" } },
        "required": ["event_type"]
      },
      "then": { "properties": { "payload": { "$ref": "#/$defs/entityCreatedPayload" } } }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "asset.tracking_started" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/assetTrackingStartedPayload" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "observer_frame.registered" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/observerFrameRegisteredPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "evidence.manifested" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/evidenceManifestedPayload" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "observation.admitted" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/observationAdmittedPayload" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "evidence.dependency_declared" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/evidenceDependencyDeclaredPayload" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "claim.created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/claimCreatedPayload" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "evidence.linked" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/evidenceLinkedPayload" } }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "relation.created" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/relationCreatedPayload" } }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "entity.resolution_candidate_recorded" }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/resolutionCandidateRecordedPayload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": { "const": "entity.resolution_candidate_assessed" }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/resolutionCandidateAssessedPayload" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "nullableUuid": {
      "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
    },
    "accessPolicy": {
      "enum": ["PUBLIC", "LICENSED", "USER_OWNED", "OTHERWISE_AUTHORIZED"]
    },
    "externalIdentifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "type",
        "canonical_name",
        "aliases",
        "external_ids",
        "attributes",
        "created_at",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$" },
        "canonical_name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "external_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/externalIdentifier" },
          "uniqueItems": true
        },
        "attributes": {
          "description": "Explicit application-domain extension point.",
          "type": "object",
          "additionalProperties": true
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["active", "dormant", "archived"] }
      },
      "additionalProperties": false
    },
    "entityCreatedPayload": {
      "type": "object",
      "required": ["entity"],
      "properties": { "entity": { "$ref": "#/$defs/entity" } },
      "additionalProperties": false
    },
    "tracking": {
      "type": "object",
      "required": ["enabled", "priority", "collection_profile", "update_policy"],
      "properties": {
        "enabled": { "const": true },
        "priority": { "type": "number", "minimum": 0, "maximum": 1 },
        "collection_profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "update_policy": { "enum": ["manual", "poll", "stream"] }
      },
      "additionalProperties": false
    },
    "trackedAsset": {
      "type": "object",
      "required": [
        "entity_id",
        "tracking",
        "scopes",
        "active_hypotheses",
        "active_scenarios",
        "active_watches",
        "epistemic_state_version"
      ],
      "properties": {
        "entity_id": { "$ref": "#/$defs/uuid" },
        "tracking": { "$ref": "#/$defs/tracking" },
        "scopes": {
          "type": "array",
          "items": { "enum": ["observer_frame", "geography", "topic", "temporal"] },
          "uniqueItems": true
        },
        "active_hypotheses": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "active_scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "active_watches": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "epistemic_state_version": { "$ref": "#/$defs/uuid" }
      },
      "additionalProperties": false
    },
    "assetTrackingStartedPayload": {
      "type": "object",
      "required": ["tracked_asset"],
      "properties": { "tracked_asset": { "$ref": "#/$defs/trackedAsset" } },
      "additionalProperties": false
    },
    "accessProjection": {
      "type": "object",
      "required": ["scope", "description"],
      "properties": {
        "scope": { "$ref": "#/$defs/accessPolicy" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "namedDescription": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "additionalProperties": false
    },
    "temporalCharacteristics": {
      "type": "object",
      "required": ["latency_class", "valid_time_available"],
      "properties": {
        "latency_class": {
          "enum": [
            "REAL_TIME",
            "NEAR_REAL_TIME",
            "HOURS",
            "DAYS",
            "MONTHS",
            "VARIABLE",
            "UNKNOWN"
          ]
        },
        "valid_time_available": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "provenanceConstraints": {
      "type": "object",
      "required": ["source_identity_required", "dependency_ancestry_required"],
      "properties": {
        "source_identity_required": { "const": true },
        "dependency_ancestry_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "observerFrame": {
      "type": "object",
      "required": [
        "id",
        "name",
        "class",
        "access_projection",
        "measurement_model",
        "granularity",
        "interpretation_model",
        "temporal_characteristics",
        "provenance_constraints",
        "known_blind_regions",
        "validity_conditions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "class": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "access_projection": { "$ref": "#/$defs/accessProjection" },
        "measurement_model": { "$ref": "#/$defs/namedDescription" },
        "granularity": { "$ref": "#/$defs/namedDescription" },
        "interpretation_model": { "$ref": "#/$defs/namedDescription" },
        "temporal_characteristics": { "$ref": "#/$defs/temporalCharacteristics" },
        "provenance_constraints": { "$ref": "#/$defs/provenanceConstraints" },
        "known_blind_regions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        },
        "validity_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "observerFrameRegisteredPayload": {
      "type": "object",
      "required": ["observer_frame"],
      "properties": { "observer_frame": { "$ref": "#/$defs/observerFrame" } },
      "additionalProperties": false
    },
    "evidenceSource": {
      "type": "object",
      "required": ["label", "uri"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 512 },
        "uri": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": ["name", "version", "input_artifact_ids", "loss_assessment"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "input_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "loss_assessment": { "enum": ["LOSSLESS_VERIFIED", "LOSSY", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "evidenceManifest": {
      "type": "object",
      "required": [
        "id",
        "sha256",
        "media_type",
        "size",
        "acquired_at",
        "source",
        "license",
        "access_policy",
        "transformations",
        "derivative_refs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "size": { "type": "integer", "minimum": 0 },
        "acquired_at": { "$ref": "#/$defs/timestamp" },
        "source": { "$ref": "#/$defs/evidenceSource" },
        "license": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "access_policy": { "$ref": "#/$defs/accessPolicy" },
        "transformations": {
          "type": "array",
          "items": { "$ref": "#/$defs/transformation" }
        },
        "derivative_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "evidenceManifestedPayload": {
      "type": "object",
      "required": ["evidence_manifest"],
      "properties": { "evidence_manifest": { "$ref": "#/$defs/evidenceManifest" } },
      "additionalProperties": false
    },
    "observationContent": {
      "type": "object",
      "required": ["structured_payload"],
      "properties": {
        "structured_payload": {
          "description": "Explicit adapter-domain extension point.",
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "observationProvenance": {
      "type": "object",
      "required": [
        "collector",
        "adapter",
        "adapter_version",
        "source_uri",
        "source_policy",
        "acquisition_time"
      ],
      "properties": {
        "collector": { "type": "string", "minLength": 1, "maxLength": 256 },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapter_version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_uri": {
          "oneOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
        },
        "source_policy": { "$ref": "#/$defs/accessPolicy" },
        "acquisition_time": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "observationEpistemic": {
      "type": "object",
      "required": [
        "resolution",
        "uncertainty",
        "access_scope",
        "missingness_state",
        "dependency_group_ids"
      ],
      "properties": {
        "resolution": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "uncertainty": {
          "description": "Explicit extension point; uncertainty is not one confidence score.",
          "type": "object",
          "additionalProperties": true
        },
        "access_scope": { "$ref": "#/$defs/accessPolicy" },
        "missingness_state": {
          "enum": [
            "OBSERVED",
            "ABSENT",
            "UNOBSERVED",
            "UNRECORDED",
            "INACCESSIBLE",
            "WITHHELD",
            "DESTROYED",
            "INCOMPARABLE",
            "UNKNOWN"
          ]
        },
        "dependency_group_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "id",
        "subject_entities",
        "observer_frame_id",
        "source_artifact_id",
        "supersedes_observation_id",
        "observed_at",
        "valid_from",
        "valid_until",
        "observation_type",
        "content",
        "provenance",
        "epistemic",
        "immutable"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "subject_entities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "observer_frame_id": { "$ref": "#/$defs/uuid" },
        "source_artifact_id": { "$ref": "#/$defs/uuid" },
        "supersedes_observation_id": { "$ref": "#/$defs/nullableUuid" },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "valid_from": { "$ref": "#/$defs/nullableTimestamp" },
        "valid_until": { "$ref": "#/$defs/nullableTimestamp" },
        "observation_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "content": { "$ref": "#/$defs/observationContent" },
        "provenance": { "$ref": "#/$defs/observationProvenance" },
        "epistemic": { "$ref": "#/$defs/observationEpistemic" },
        "immutable": { "const": true }
      },
      "additionalProperties": false
    },
    "observationAdmittedPayload": {
      "type": "object",
      "required": ["observation"],
      "properties": { "observation": { "$ref": "#/$defs/observation" } },
      "additionalProperties": false
    },
    "evidenceDependency": {
      "type": "object",
      "required": [
        "id",
        "dependency_group_id",
        "ancestor_evidence_id",
        "descendant_evidence_id",
        "relationship",
        "verification_status",
        "basis",
        "declared_at",
        "independence_disposition"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "dependency_group_id": { "$ref": "#/$defs/uuid" },
        "ancestor_evidence_id": { "$ref": "#/$defs/uuid" },
        "descendant_evidence_id": { "$ref": "#/$defs/uuid" },
        "relationship": {
          "enum": [
            "DERIVED_FROM",
            "CITES",
            "SUMMARIZES",
            "REPRODUCES",
            "TRANSFORMS",
            "UNKNOWN_SHARED_ANCESTRY"
          ]
        },
        "verification_status": {
          "enum": ["ASSERTED_NOT_VERIFIED", "VERIFIED_FROM_MANIFEST"]
        },
        "basis": {
          "type": "object",
          "required": ["method", "notes"],
          "properties": {
            "method": {
              "enum": [
                "MANIFEST_TRANSFORMATION",
                "EXPLICIT_CITATION",
                "CONTENT_LINEAGE",
                "SOURCE_DISCLOSURE",
                "USER_ASSERTED"
              ]
            },
            "notes": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "additionalProperties": false
        },
        "declared_at": { "$ref": "#/$defs/timestamp" },
        "independence_disposition": { "const": "DEPENDENT" }
      },
      "additionalProperties": false
    },
    "evidenceDependencyDeclaredPayload": {
      "type": "object",
      "required": ["dependency"],
      "properties": { "dependency": { "$ref": "#/$defs/evidenceDependency" } },
      "additionalProperties": false
    },
    "claimObject": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "entity_id"],
          "properties": {
            "kind": { "const": "ENTITY" },
            "entity_id": { "$ref": "#/$defs/uuid" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "LITERAL" },
            "value": { "type": ["string", "number", "boolean", "null"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "temporalScope": {
      "type": "object",
      "required": ["valid_from", "valid_until"],
      "properties": {
        "valid_from": { "$ref": "#/$defs/nullableTimestamp" },
        "valid_until": { "$ref": "#/$defs/nullableTimestamp" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "temporal_scope",
        "spatial_scope",
        "derived_from",
        "modality",
        "epistemic_status",
        "invalidation_conditions",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "subject": { "$ref": "#/$defs/uuid" },
        "predicate": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
        "object": { "$ref": "#/$defs/claimObject" },
        "temporal_scope": { "$ref": "#/$defs/temporalScope" },
        "spatial_scope": { "type": "null" },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "modality": {
          "enum": [
            "asserted",
            "inferred",
            "predicted",
            "hypothetical",
            "counterfactual",
            "disputed"
          ]
        },
        "epistemic_status": { "const": "unresolved" },
        "invalidation_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "uniqueItems": true
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "claimCreatedPayload": {
      "type": "object",
      "required": ["claim"],
      "properties": { "claim": { "$ref": "#/$defs/claim" } },
      "additionalProperties": false
    },
    "warrant": {
      "type": "object",
      "required": ["status", "statement", "basis"],
      "properties": {
        "status": { "enum": ["NOT_PROVIDED", "PROVIDED"] },
        "statement": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 4096 },
            { "type": "null" }
          ]
        },
        "basis": {
          "oneOf": [
            {
              "enum": [
                "DIRECT_SOURCE_REPORT",
                "DOCUMENTARY_RECORD",
                "INFERENTIAL_CHAIN",
                "CONTEXTUAL_CONSTRAINT"
              ]
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "appraisal": {
      "type": "object",
      "required": ["status", "method", "notes"],
      "properties": {
        "status": { "enum": ["NOT_APPRAISED", "APPRAISED"] },
        "method": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "notes": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 2048 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceStrength": {
      "type": "object",
      "required": ["status", "ordinal"],
      "properties": {
        "status": { "enum": ["UNASSESSED", "ASSESSED"] },
        "ordinal": {
          "oneOf": [
            { "enum": ["WEAK", "MODERATE", "STRONG"] },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceLink": {
      "type": "object",
      "required": [
        "id",
        "evidence_id",
        "claim_id",
        "role",
        "dependency_group",
        "warrant",
        "appraisal",
        "strength",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "evidence_id": { "$ref": "#/$defs/uuid" },
        "claim_id": { "$ref": "#/$defs/uuid" },
        "role": {
          "enum": [
            "supports",
            "challenges",
            "contextualizes",
            "constrains",
            "derives",
            "contradicts"
          ]
        },
        "dependency_group": { "$ref": "#/$defs/nullableUuid" },
        "warrant": { "$ref": "#/$defs/warrant" },
        "appraisal": { "$ref": "#/$defs/appraisal" },
        "strength": { "$ref": "#/$defs/evidenceStrength" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "evidenceLinkedPayload": {
      "type": "object",
      "required": ["evidence_link"],
      "properties": { "evidence_link": { "$ref": "#/$defs/evidenceLink" } },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source_entity",
        "relation_type",
        "relation_semantics",
        "target_entity",
        "valid_from",
        "valid_until",
        "claims",
        "confidence_state",
        "created_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "source_entity": { "$ref": "#/$defs/uuid" },
        "relation_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_?]{0,63}$" },
        "relation_semantics": {
          "enum": ["DESCRIPTIVE", "ASSOCIATION", "CAUSAL_HYPOTHESIS"]
        },
        "target_entity": { "$ref": "#/$defs/uuid" },
        "valid_from": { "$ref": "#/$defs/nullableTimestamp" },
        "valid_until": { "$ref": "#/$defs/nullableTimestamp" },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        },
        "confidence_state": {
          "type": "object",
          "required": ["status", "rationale"],
          "properties": {
            "status": { "const": "UNASSESSED" },
            "rationale": { "type": "null" }
          },
          "additionalProperties": false
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "relationCreatedPayload": {
      "type": "object",
      "required": ["relation"],
      "properties": { "relation": { "$ref": "#/$defs/relation" } },
      "additionalProperties": false
    },
    "resolutionSignal": {
      "type": "object",
      "required": [
        "kind",
        "polarity",
        "verification_status",
        "statement",
        "observation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SHARED_ALIAS",
            "SHARED_EXTERNAL_ID",
            "ATTRIBUTE_SIMILARITY",
            "OBSERVATION_REFERENCE",
            "USER_ASSERTION",
            "CONTRADICTION"
          ]
        },
        "polarity": {
          "enum": ["SUPPORTS_CANDIDACY", "CHALLENGES_CANDIDACY"]
        },
        "verification_status": {
          "enum": [
            "ASSERTED_NOT_VERIFIED",
            "REFERENCE_VALIDATED",
            "ENTITY_RECORD_VALIDATED"
          ]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "observation_id": { "$ref": "#/$defs/nullableUuid" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "OBSERVATION_REFERENCE" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "observation_id": { "$ref": "#/$defs/uuid" } }
          },
          "else": {
            "properties": { "observation_id": { "type": "null" } }
          }
        }
      ],
      "additionalProperties": false
    },
    "resolutionCandidate": {
      "type": "object",
      "required": [
        "id",
        "left_entity_id",
        "right_entity_id",
        "candidate_relation",
        "signals",
        "status",
        "automatic_merge",
        "merge_state",
        "recorded_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "left_entity_id": { "$ref": "#/$defs/uuid" },
        "right_entity_id": { "$ref": "#/$defs/uuid" },
        "candidate_relation": { "const": "POSSIBLE_SAME_ENTITY" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolutionSignal" },
          "uniqueItems": true
        },
        "status": { "const": "PENDING_REVIEW" },
        "automatic_merge": { "const": false },
        "merge_state": { "const": "NOT_MERGED" },
        "recorded_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "resolutionCandidateRecordedPayload": {
      "type": "object",
      "required": ["resolution_candidate"],
      "properties": {
        "resolution_candidate": { "$ref": "#/$defs/resolutionCandidate" }
      },
      "additionalProperties": false
    },
    "manualReviewer": {
      "type": "object",
      "required": ["mode", "label"],
      "properties": {
        "mode": { "const": "MANUAL" },
        "label": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "resolutionAssessment": {
      "type": "object",
      "required": [
        "id",
        "candidate_id",
        "disposition",
        "rationale",
        "reviewer",
        "supersedes_assessment_id",
        "automatic_merge",
        "merge_state",
        "assessed_at"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "candidate_id": { "$ref": "#/$defs/uuid" },
        "disposition": {
          "enum": [
            "POSSIBLE_MATCH",
            "RETAIN_SEPARATE",
            "REJECTED_AS_MATCH",
            "CONFIRMED_MATCH_NOT_MERGED"
          ]
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "reviewer": { "$ref": "#/$defs/manualReviewer" },
        "supersedes_assessment_id": { "$ref": "#/$defs/nullableUuid" },
        "automatic_merge": { "const": false },
        "merge_state": { "const": "NOT_MERGED" },
        "assessed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "resolutionCandidateAssessedPayload": {
      "type": "object",
      "required": ["resolution_assessment"],
      "properties": {
        "resolution_assessment": { "$ref": "#/$defs/resolutionAssessment" }
      },
      "additionalProperties": false
    }
  }
}
