        "outcome_sha256": { "$ref": "#/$defs/sha256" },
        "executed_at": { "$ref": "#/$defs/timestamp" },
        "authority_state": { "const": "NO_AUTHORITY" }
      },
      "additionalProperties": false
    },
    "fitterRun": {
      "type": "object",
      "required": [
        "id",
        "run_group_id",
        "query_plan_id",
        "fitter_id",
        "outcome",
        "admissibility",
        "fit_result",
        "execution_receipt",
